{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron desktop shell for the DeepSeek Harness Web GUI: launches the bundled dsh web server on a loopback port and opens it in a native window",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "license": "MIT",
  "author": "DeepSeek AI",
  "desktopName": "deepseek-harness",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run build && electron .",
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run --root ../.. apps/desktop/tests",
    "pack": "pnpm run build && electron-builder",
    "pack:dir": "pnpm run build && electron-builder --dir",
    "pack:win": "pnpm run build && electron-builder --win",
    "pack:linux": "pnpm run build && electron-builder --linux",
    "pack:mac": "pnpm run build && electron-builder --mac"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-anonymous-user-id": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^",
    "@deepseek-ai/dsh-code-runtime": "workspace:^",
    "@deepseek-ai/dsh-compaction": "workspace:^",
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-output-retention": "workspace:^",
    "@deepseek-ai/dsh-sandbox": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session-telemetry": "workspace:^",
    "@deepseek-ai/dsh-session-title-llm": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-spill": "workspace:^",
    "@deepseek-ai/dsh-subagent-in-process-driver": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/dsh-workflow": "workspace:^"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.deepseek.dsh.desktop",
    "productName": "DeepSeek Harness",
    "icon": "../../assets/icon2.png",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!src/**/*",
      "!tests/**/*",
      "!tsconfig*.json",
      "!tsdown.config.ts",
      "!README*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "deepseek-harness",
      "maintainer": "DeepSeek AI <maintainers@deepseek.com>",
      "syncDesktopName": true,
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "icon.png"
    }
  },
  "optionalDependencies": {
    "@koromix/koffi-win32-x64": "3.1.1",
    "@koromix/koffi-win32-arm64": "3.1.1",
    "@koromix/koffi-darwin-arm64": "3.1.1",
    "@koromix/koffi-darwin-x64": "3.1.1",
    "@koromix/koffi-linux-arm64": "3.1.1",
    "@koromix/koffi-linux-x64": "3.1.1"
  }
}
